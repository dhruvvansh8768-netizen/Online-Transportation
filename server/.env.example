# Server configuration
PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=ridehailing_db

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend origin
CLIENT_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Optional map API key
MAP_API_KEY=

# Fare configuration
BASE_FARE=25
COST_PER_KM=12
COST_PER_MIN=2
MINIMUM_FARE=50
SURGE_MULTIPLIER=1.0
